# Autosouq CMS (Strapi 5) — environment template
#
# Copy to .env and fill in. The values below are DEFAULTS AND PLACEHOLDERS, not
# working settings: every secret must be regenerated before this reaches a
# server. See DEPLOYMENT.md for the full OVH deployment procedure.
#
#   cp .env.example .env
#
# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each one fresh. Do NOT ship the placeholders: `ADMIN_JWT_SECRET` on a
# reachable instance is admin-token forgery, and "tobemodified" is the first
# thing anyone would try.
#
#   APP_KEYS:  node -e "console.log(Array.from({length:4},()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
#   the rest:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
#
APP_KEYS="REPLACE_ME_1,REPLACE_ME_2,REPLACE_ME_3,REPLACE_ME_4"
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
JWT_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# ── Networking ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# The PUBLIC origin browsers reach this Strapi on, including scheme, no trailing
# slash. REQUIRED in production.
#
# Without it Strapi builds absolute URLs from HOST:PORT and, because HOST is
# 0.0.0.0, hands out `http://0.0.0.0:1337` as the base for admin links,
# password-reset emails and every uploaded media URL — none of which resolve
# from a browser. Must be https: the web app sends `upgrade-insecure-requests`,
# so a plain-http CMS origin has its image requests rewritten to https by the
# browser and they fail.
PUBLIC_URL=https://cms.autosouq.om

# Set to true when a reverse proxy (nginx, HAProxy, OVH load balancer)
# terminates TLS in front of this server — which is the normal OVH setup.
# Without it Strapi sees every request as plain http from the proxy's own IP:
# wrong protocol in generated URLs, wrong client IP in the logs, and `secure`
# session cookies may not be set. Leave false if the server is directly
# internet-facing, because a trusted X-Forwarded-For is then spoofable.
TRUST_PROXY=true

# The deployed web app origin. REQUIRED in production — the CMS refuses to boot
# without it rather than fall back to a localhost-only CORS allowlist that
# nobody would notice was wrong.
FRONTEND_URL=https://autosouq.om

# ── Database ─────────────────────────────────────────────────────────────────
# Local development uses SQLite. Production MUST NOT: config/database.ts
# defaults to a gitignored `.tmp/data.db`, which on a rebuildable instance does
# not survive redeploy, and src/index.ts refuses to start on it in production
# rather than lose listings silently.
#
# For OVH, provision a Managed PostgreSQL (or a Postgres on the instance) and
# set the block below instead:
#
#   DATABASE_CLIENT=postgres
#   DATABASE_HOST=<host>
#   DATABASE_PORT=5432
#   DATABASE_NAME=autosouq
#   DATABASE_USERNAME=<user>
#   DATABASE_PASSWORD=<password>
#   DATABASE_SSL=true                      # OVH managed Postgres requires TLS
#   DATABASE_SSL_REJECT_UNAUTHORIZED=true  # set false ONLY for a self-signed CA
#
# `DATABASE_URL` is also honoured and takes precedence over the parts above.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Escape hatch for the production SQLite guard. Only true if the database file
# is on a persistent volume that you back up.
# ALLOW_SQLITE_IN_PRODUCTION=false

# ── Uploads ──────────────────────────────────────────────────────────────────
# Per-file limit in MB (default 12). Strapi's own default is 1 GB, which on a
# real disk is a way to fill the volume. Note the reverse proxy has its own body
# limit — nginx `client_max_body_size` defaults to 1 MB — and the smaller wins.
# UPLOAD_SIZE_LIMIT_MB=12

# ── Operational flags ────────────────────────────────────────────────────────
# Seed the demo catalogue on boot.
#
#   true    seed even in production
#   false   never seed
#   unset   seed outside production only (the default, so local dev just works)
#
# Left unset on purpose. A managed database starts empty, and without this guard
# a first boot fills production with demo listings whose photos are all
# AI-generated stand-ins.
SEED_DEMO_DATA=

# One-shot migration that rewrites listing title/description language fields to
# repair the original seed's language mix-up. Off by default; set true only to
# run it deliberately against a database that still needs it, then unset.
# REPAIR_LISTING_LANGUAGE=false
