HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
FRONTEND_URL=http://localhost:3001

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Seed the demo catalogue on boot.
#
#   true    seed even in production
#   false   never seed
#   unset   seed outside production only (the default, so local dev just works)
#
# Left unset here on purpose. On Strapi Cloud the managed database starts
# empty, and without this guard the first boot filled production with demo
# listings whose photos are all stand-ins.
#
# NOTE for Strapi Cloud: do NOT set any variable starting with DATABASE_ there.
# Cloud provides a managed PostgreSQL instance and injects its own DATABASE_*
# values; adding one of your own makes it assume an external database and it
# then injects none of them. config/database.ts already reads what Cloud sets.
SEED_DEMO_DATA=
