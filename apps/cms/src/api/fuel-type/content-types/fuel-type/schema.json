{
  "kind": "collectionType",
  "collectionName": "fuel_types",
  "info": {
    "singularName": "fuel-type",
    "pluralName": "fuel-types",
    "displayName": "Fuel Type"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "nameAr": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "listings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::listing.listing",
      "mappedBy": "fuelType"
    }
  }
}
