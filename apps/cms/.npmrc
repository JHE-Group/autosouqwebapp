# Standalone install settings for apps/cms.
#
# The repo is a pnpm workspace and these normally come from the root
# pnpm-workspace.yaml. They are restated here for any install that runs *inside*
# apps/cms rather than at the workspace root — which is what happens when the
# CMS is deployed on its own, as it is on OVH: the deploy either copies this
# directory alone or runs `pnpm install` here, and in both cases
# pnpm-workspace.yaml is never read and those settings are silently lost.
#
# (This originally existed for Strapi Cloud's "Base directory = apps/cms" build.
# The target changed; the requirement did not, because it is a property of
# installing below the workspace root, not of any one host.)
#
# NOTE: apps/cms/pnpm-lock.yaml is what a standalone install resolves from, and
# it is a SECOND lockfile — it does not update when the root one does. Any change
# to apps/cms/package.json must be followed by:
#
#     pnpm install --lockfile-only --ignore-workspace   # run inside apps/cms
#
# Skipping that ships a lockfile missing the new dependency: a frozen-lockfile
# install then fails outright, and a non-frozen one silently installs without it.
# That is exactly how `pg` went missing while config/database.ts required it.
#
# shamefully-hoist: Strapi resolves plugin and admin modules from a flat
# node_modules. Without it the admin build fails to find its own packages.
shamefully-hoist=true

# The @uiw/react-codemirror -> codemirror peer range is unmet upstream in
# Strapi 5.51.0's admin dependency tree. The workspace already tolerates this;
# without it a standalone install fails outright on a conflict we do not own.
strict-peer-dependencies=false
