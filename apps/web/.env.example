# Strapi CMS (apps/cms). Production: https://app.autosouq.om
#
# BAKED IN AT BUILD TIME. This value is compiled into the bundle, and two things
# are derived from it that are easy to miss: `images.remotePatterns` (the
# allowlist for /_next/image) and the `img-src`/`connect-src` of the CSP. So
# changing the CMS origin requires a web REBUILD, not a restart — a restart
# leaves the old host in both.
#
# Must be https and publicly resolvable. A private or loopback address still
# lets server-side fetches work, so pages render fine while every listing photo
# 400s — Next refuses to optimise an upstream that resolves to a private IP.
NEXT_PUBLIC_STRAPI_URL=https://app.autosouq.om

# Google Maps — used by the map listing views and the dashboard map.
# Maps render blank until a key with billing enabled is set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# EmailJS — contact form + footer newsletter form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# The site's own public origin. **Must be the host that actually serves the
# page, including `www` if that is the canonical host.** This value becomes
# every canonical, every hreflang, every sitemap <loc>, the robots.txt Sitemap:
# line and the OG url — so pointing it at the apex while serving from www makes
# every canonical reference a different host.
#
# Pick ONE host and 301 the other at the DNS/proxy layer. Do not serve both.
NEXT_PUBLIC_SITE_URL=https://www.autosouq.om

# Autosouq's own WhatsApp number, in full international form without the "+"
# (e.g. 96890000000). Used by two click-to-chat controls: "tell me when a car
# like this is listed" on the empty-results screen, and "report this listing"
# on the detail page. Both controls are ABSENT when this is unset, rather than
# rendered dead — a "notify me" button that goes nowhere is worse than none on
# a site whose proposition is trustworthiness.
NEXT_PUBLIC_AUTOSOUQ_WHATSAPP=

# Show the demo catalogue (data/cars.js) when the CMS has no listings.
#
#   true    demo cars stand in, even in production
#   unset   demo cars stand in outside production only (the default)
#
# Off by default because those cars do not exist, and a visitor to a live
# marketplace seeing fabricated inventory is the failure this product exists to
# oppose — `noindex` protects Google, not the person reading the page.
#
# Turn it on deliberately and temporarily: a stakeholder demo, or a staging
# deploy before real inventory lands. It is INERT once the CMS has any listing,
# because the fallback only fires on an empty catalogue — so it is safe to
# leave set through launch and remove later.
NEXT_PUBLIC_ALLOW_DEMO_LISTINGS=true
