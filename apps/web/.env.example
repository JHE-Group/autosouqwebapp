# Strapi CMS (apps/cms)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Google Maps — used by the map listing views and the dashboard map.
# Maps render blank until a key with billing enabled is set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# EmailJS — contact form + footer newsletter form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# The site's own public origin. **Must be the host that actually serves the
# page, including `www` if that is the canonical host.** This value becomes
# every canonical, every hreflang, every sitemap <loc>, the robots.txt Sitemap:
# line and the OG url — so pointing it at the apex while serving from www makes
# every canonical reference a different host.
#
# Pick ONE host and 301 the other at the DNS/proxy layer. Do not serve both.
NEXT_PUBLIC_SITE_URL=https://www.autosouq.om

# Autosouq's own WhatsApp number, in full international form without the "+"
# (e.g. 96890000000). Used by two click-to-chat controls: "tell me when a car
# like this is listed" on the empty-results screen, and "report this listing"
# on the detail page. Both controls are ABSENT when this is unset, rather than
# rendered dead — a "notify me" button that goes nowhere is worse than none on
# a site whose proposition is trustworthiness.
NEXT_PUBLIC_AUTOSOUQ_WHATSAPP=
