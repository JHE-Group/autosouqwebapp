{
  "name": "autosouq",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @autosouq/web --filter @autosouq/cms dev",
    "dev:web": "pnpm --filter @autosouq/web dev",
    "dev:cms": "pnpm --filter @autosouq/cms develop",
    "db:dev": "node scripts/dev-db.mjs",
    "db:dev:reset": "node scripts/dev-db.mjs --reset",
    "build": "pnpm --filter @autosouq/web --filter @autosouq/cms build",
    "lint": "pnpm --filter @autosouq/web lint",
    "check:band": "node scripts/check-price-band.mjs",
    "check": "pnpm check:band && pnpm lint",
    "test:carousels": "node scripts/test-carousels.mjs",
    "check:photos": "node scripts/check-listing-photos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "playwright-core": "1.54.0"
  }
}
