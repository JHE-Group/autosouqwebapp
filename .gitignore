# Every dotenv form except the checked-in templates. The previous three-line
# list (.env, .env.local, .env.*.local) left `.env.production` tracked — and
# that is a first-class Next.js convention file that `next build` loads, so it
# is exactly where a real production secret would land.
.env*
!.env.example
!.env*.example
*.log
.strapi
.tmp
.pnpm-store
*.tsbuildinfo
apps/cms/.tmp
apps/cms/public/uploads
apps/cms/dist
apps/cms/build
apps/cms/.cache
coverage
.vercel

# Strapi data exports — contain user, role and permission records.
# Never commit a database dump.
.migration/
*.tar.gz.enc
