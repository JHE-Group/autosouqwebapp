node_modules
.DS_Store
.next
.turbo
dist
build
# Every dotenv form except the checked-in templates. The previous three-line
# list (.env, .env.local, .env.*.local) left `.env.production` tracked — and
# that is a first-class Next.js convention file that `next build` loads, so it
# is exactly where a real production secret would land.
.env*
!.env.example
!.env*.example
*.log
.strapi
.tmp
.pnpm-store
*.tsbuildinfo
apps/cms/.tmp
# Uploaded media stays out of git, but the DIRECTORY has to exist: the local
# upload provider checks for it at boot and Strapi refuses to start without it
# ("The upload folder ... doesn't exist or is not accessible"). Ignoring the
# path outright meant a fresh clone — which is exactly how the CMS branch is
# deployed to OVH — could not boot until someone mkdir'd it by hand.
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep
apps/cms/dist
apps/cms/build
apps/cms/.cache
coverage
.vercel

# Strapi data exports — contain user, role and permission records.
# Never commit a database dump.
.migration/
*.tar.gz.enc

# Scratch space for QA agents and manual probing. Never part of a build.
.qa-tmp/
**/.qa-tmp/
